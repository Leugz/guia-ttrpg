{
  "$schema": "https://schema.tauri.app/2/tauri.schema.json",
  "productName": "OP2-Playtest",
  "version": "1.0.0",
  "identifier": "com.guia.ttrpg",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "G.U.I.A TTRPG",
        "width": 1280,
        "height": 720,
        "backgroundColor": "#171717"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/.local/share/com.guia.ttrpg/games/**/*"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "resources": {
      "../campaigns/act_1/templates/*.md": "campaigns/act_1/templates/",
      "../campaigns/act_1/templates/handouts/*": "campaigns/act_1/templates/handouts/",
      "../campaigns/act_1/templates/maps/*": "campaigns/act_1/templates/maps/",
      "../campaigns/act_1/templates/assets/**/*": "campaigns/act_1/templates/assets/"
    }
  }
}
