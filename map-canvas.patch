diff --git a/src-tauri/src/api.rs b/src-tauri/src/api.rs
index 1ce11ed..78780b2 100644
--- a/src-tauri/src/api.rs
+++ b/src-tauri/src/api.rs
@@ -790,3 +790,95 @@ pub fn get_handout_asset(root: &Path, handout_id: &str) -> Result<HandoutAsset,
